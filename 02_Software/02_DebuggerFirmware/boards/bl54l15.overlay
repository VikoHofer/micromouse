&pinctrl {
    uart20_default: uart20_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 2, 2)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 2, 0)>, <NRF_PSEL(UART_RX, 2, 0)>; /* somehow only works if defined like this */
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 2, 2)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 2, 0)>, <NRF_PSEL(UART_RX, 2, 0)>;
        };
    };
};

&uart20 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart20_default>;
    pinctrl-1 = <&uart20_sleep>;
    pinctrl-names = "default", "sleep";
};

&gpio0 {
    status = "okay";
};

 / {
    leds {
        compatible = "gpio-leds";
        status_led: led_0 {
            gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;  /* P0.01 */
            label = "Status LED";
        };
    };

    external_resets {
        compatible = "gpio-leds";
        external_reset: ctrl_0 {
            gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;  /* P0.02 */
            label = "external reset (Active Low)";
        };
    };
};
