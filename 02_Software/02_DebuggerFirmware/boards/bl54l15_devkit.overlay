&pinctrl {
    uart20_default: uart20_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 8)>;
        };

        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 9)>, <NRF_PSEL(UART_RX, 1, 9)>;
        };
    };

    uart20_sleep: uart20_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 8)>,
                    <NRF_PSEL(UART_RX, 1, 9)>;
        };
    };
};

&uart20 {
    status = "okay";
    current-speed = <9600>;
    pinctrl-0 = <&uart20_default>;
    pinctrl-1 = <&uart20_sleep>;
    pinctrl-names = "default", "sleep";
};

&gpio0 {
    status = "okay";
};

 / {
    leds {
        compatible = "gpio-leds";
        status_led: led_0 {
            gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;  /* P0.01 */
            label = "Status LED";
        };
    };

    external_resets {
        compatible = "gpio-leds";
        external_reset: ctrl_0 {
            gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;  /* P0.04 */
            label = "external reset (Active Low)";
        };
    };
};

